# Copie este arquivo para ".env" e preencha com os dados do seu projeto
# Firebase (Configurações do projeto > Seus apps > SDK setup and configuration).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail da conta admin (a mesma que você vai criar no Firebase Authentication).
# Precisa ser IGUAL ao e-mail hardcoded em firestore.rules.
VITE_ADMIN_EMAIL=ricardoaceranto@gmail.com
